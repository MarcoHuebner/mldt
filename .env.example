# The checkpoint is not installed by the Python dependency; obtain it separately.
# Directory containing mcmlnet model-version folders.
model_dir="/path/to/mcmlnet/data/models/"
# Folder under model_dir; it must contain config_log.yaml.
model_version="version_23_enhanced_g_and_n_range_combined_rerun_nll"
# Checkpoint path relative to the selected model-version folder.
checkpoint_path="checkpoints/HeteroscedasticForwardSurrogateModel-epoch=999-val_loss=0.0001.ckpt"
